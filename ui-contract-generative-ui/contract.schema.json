{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted UI Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "screen", "components"],
  "properties": {
    "version": { "const": "1" },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/textInput" },
          { "$ref": "#/$defs/select" },
          { "$ref": "#/$defs/button" }
        ]
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "label", "token"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "token": { "enum": ["surface.default", "surface.muted", "action.primary"] }
      }
    },
    "textInput": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "label", "token", "name", "inputMode"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "type": { "const": "textInput" },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "token": { "enum": ["surface.default", "surface.muted", "action.primary"] },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "inputMode": { "enum": ["text", "email", "numeric"] },
            "required": { "type": "boolean" }
          }
        }
      ]
    },
    "select": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "label", "token", "name", "options"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "type": { "const": "select" },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "token": { "enum": ["surface.default", "surface.muted", "action.primary"] },
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "value": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" }
                }
              }
            }
          }
        }
      ]
    },
    "button": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "label", "token", "action"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
            "type": { "const": "button" },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "token": { "enum": ["surface.default", "surface.muted", "action.primary"] },
            "action": { "enum": ["submit", "reset"] }
          }
        }
      ]
    }
  }
}
